# OpenAI API Key (for GPT-4o)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude 3.5 Sonnet)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Selection (openai or anthropic)
LLM_PROVIDER=openai
MODEL_NAME=gpt-4o

# Agent Configuration
MAX_ITERATIONS=10
ENABLE_SANDBOX=true

